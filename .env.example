# Exemplo de variáveis de ambiente para o projeto Analytic-Eyes
#
# O arquivo .env REAL usado pela aplicação fica em etl-manager/.env
# (lido por etl-manager/backend/config/settings.py e pelo
# etl-manager/docker-compose-dev.yml). Copie este arquivo para
# etl-manager/.env e substitua pelos valores reais.

# Django / Configuração geral
SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings
DEBUG=True

# Superusuário Django
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin

# Hosts e CORS
# Em produção (settings_prod.py), o default já cobre analytic-eyes.com/
# www.analytic-eyes.com/localhost/127.0.0.1 - só precisa sobrescrever
# ALLOWED_HOSTS aqui se estiver acessando por um host que não é esses (ex:
# o IP público da EC2 diretamente, antes do DNS do domínio estar apontado -
# sem isso, toda chamada de API volta 400 Bad Request/DisallowedHost).
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Banco de dados (produção / Aurora PostgreSQL via AWS Secrets Manager)
# DB_SECRET_ARN: ARN do secret gerenciado pelo Aurora ("Manage master user
# password in Secrets Manager"). Formato REAL do JSON desse secret (
# confirmado em produção): {"username":"...","password":"..."} - só isso,
# nada de host/port/dbname. São credenciais que giram, não uma string de
# conexão completa.
# Por isso DB_NAME/DB_HOST/DB_PORT abaixo são SEMPRE necessários, mesmo com
# DB_USE_SECRETS_MANAGER=true (vêm dos outputs do Terraform: db_name,
# db_endpoint, e a porta do Postgres é 5432).
DB_SECRET_ARN=
DB_NAME=your_db_name
DB_HOST=your_db_host
DB_PORT=5432
# "false" apenas em staging/teste sem Secrets Manager configurado - usa
# DB_USER/DB_PASSWORD/DB_HOST/DB_PORT diretamente. Nunca é um fallback
# automático quando o secret falha (a aplicação recusa subir nesse caso).
DB_USE_SECRETS_MANAGER=true
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Armazenamento de pipeline
PIPELINE_STORAGE_TYPE=s3 # local ou s3
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_DEFAULT_REGION=us-east-1
# Deixe AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY em branco quando a instância
# EC2 tiver uma IAM Role anexada (recomendado) - boto3 usa a role
# automaticamente para S3 e para o AWS Secrets Manager (DB_SECRET_ARN acima).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_ENDPOINT_URL=
PIPELINE_S3_PREFIX=etls

# Configuração de ETL / Docker
# Deixe em branco na maioria dos casos: o worker reaproveita o próprio
# volume ./etls:/etls (via volumes_from) em vez de montar um caminho
# absoluto do host. Preencher com um valor incorreto (ex: um caminho que
# não existe de verdade no host) faz o Docker montar um diretório VAZIO
# por cima do /etls do container - já causou "runner.py not found" real.
# Só preencha se volumes_from não servir, com o caminho absoluto REAL do
# host (no WSL, use /mnt/c/...; descubra com 'pwd' dentro de etl-manager/etls).
ETL_HOST_PATH=
ETL_DOCKER_NETWORK=etl-manager_default
ETL_CONTAINER_MEM_LIMIT=512m
ETL_CONTAINER_CPUSET=

# Celery / worker
# 30 é alto demais para uma EC2 pequena (t3.small/t3.medium) - já derrubou
# uma instância em produção (worker + backend + redis + nginx disputando
# memória, até o SSH parou de responder). Use 2-4 para essas instâncias;
# só suba se o tamanho da máquina acompanhar.
CELERY_WORKER_CONCURRENCY=4

# Senha do Redis (broker do Celery). Vazio = sem autenticação (só ok em
# dev local, nunca em produção - settings_prod.py recusa subir sem isso).
# Gere um valor forte: python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/

# Variáveis opcionais para compose / fallback
SQLITE_PATH=/app/data/db.sqlite3
DOCKER_HOST=tcp://socket-proxy:2375

# Variáveis usadas pelos ETLs internos (opcional)
API_PIPELINE_URL=http://api.pipeline.com
DB_CONNECTION=sqlite:///pipeline.db
