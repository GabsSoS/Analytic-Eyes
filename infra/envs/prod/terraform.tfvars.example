# Copie para terraform.tfvars (gitignored) e preencha com seus valores reais.

# Aplicação de uso interno: só esses CIDRs acessam o ALB (HTTP redireciona
# pra HTTPS, HTTPS é onde a app é servida de verdade). Nunca inclua
# 0.0.0.0/0 aqui.
app_allowed_cidrs = [
  "IP_DO_ESCRITORIO/32",
  "IP_DA_VPN_CORPORATIVA/32",
]

# Domínio do certificado ACM/ALB - ver "TLS (ACM)" no README para o passo
# de validação via DNS.
domain_name      = "seu-dominio.com"
domain_alt_names = ["www.seu-dominio.com"]

s3_bucket_name = "analytic-eyes-pipelines-prod" # precisa ser único globalmente na AWS

# Network Firewall (opcional): inspeciona a saída da EC2, só libera os
# domínios em modules/network/variables.tf (Docker Hub, PyPI, npm, apt,
# GitHub, AWS). Desligado por padrão - custo real de ~US$395/mês +
# processamento se ligar. Descomente pra habilitar:
# enable_network_firewall = true

# Shield Advanced (opcional): só funciona se a conta JÁ tiver assinatura
# ativa do Shield Advanced (US$3.000/mês, feita manualmente no Console -
# não é algo que o Terraform cria). Descomente só depois de assinar:
# enable_shield_advanced = true
