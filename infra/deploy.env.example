# Copie este arquivo para infra/deploy.env e preencha com os dados da sua
# EC2. infra/deploy.env é gitignored (mesma lógica do terraform.tfvars).
#
# A EC2 não tem IP público (fica atrás do ALB) - o deploy é feito via SSM
# Run Command, não mais via SSH. Isso exige a AWS CLI configurada
# localmente (`aws configure`) com permissão para ssm:SendCommand /
# ssm:GetCommandInvocation nesta instância.

# ID da instância (output ec2_instance_id do Terraform, ou AWS Console ->
# EC2 -> instância -> Instance ID, algo como i-0123456789abcdef0)
INSTANCE_ID=

# Região AWS onde a instância roda
AWS_REGION=us-east-1

# Perfil da AWS CLI a usar (opcional - deixe em branco para usar o default)
AWS_PROFILE=

# Pasta do repositório dentro da EC2, relativa ao $HOME do usuário ubuntu
REMOTE_DIR=Analytic-Eyes

# Branch a ser publicada
BRANCH=main

# URL do repositório git - só é usada se REMOTE_DIR ainda não existir na
# EC2 (primeiro deploy nessa instância)
REPO_URL=https://github.com/SEU-USUARIO/Analytic-Eyes.git
