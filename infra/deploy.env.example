# Copie este arquivo para infra/deploy.env e preencha com os dados da sua
# EC2. infra/deploy.env é gitignored (mesma lógica do terraform.tfvars) -
# nunca comite esse arquivo, ele aponta para sua chave SSH privada.

# IP público ou DNS da EC2 (output ec2_public_ip do Terraform, ou AWS
# Console -> EC2 -> instância -> IPv4 público)
EC2_HOST=

# Usuário SSH da instância (AMI Ubuntu = ubuntu)
EC2_USER=ubuntu

# Caminho local da chave privada usada para acessar a instância
SSH_KEY=~/.ssh/sua-chave.pem

# Pasta do repositório dentro da EC2, relativa ao $HOME do EC2_USER
REMOTE_DIR=Analytic-Eyes

# Branch a ser publicada
BRANCH=main

# URL do repositório git - só é usada se REMOTE_DIR ainda não existir na
# EC2 (primeiro deploy nessa instância)
REPO_URL=https://github.com/SEU-USUARIO/Analytic-Eyes.git
